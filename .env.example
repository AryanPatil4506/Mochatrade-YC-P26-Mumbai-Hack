# Copy this file to `.env` (already gitignored — never commit real secrets)
# and fill in your own key. Loaded automatically at service startup via
# python-dotenv; nothing here is required for tests, which run the offline
# stub in services/agent/llm/client.py when GROQ_API_KEY is unset.

# Groq API key for the in-path, non-authoritative action-proposal LLM call
# (services/agent/llm/client.py). Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides — defaults are fine for most setups.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
